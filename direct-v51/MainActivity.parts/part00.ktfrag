class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        window.decorView.layoutDirection = View.LAYOUT_DIRECTION_RTL
        setContent {
            CompositionLocalProvider(androidx.compose.ui.platform.LocalLayoutDirection provides LayoutDirection.Rtl) {
                MaterialTheme {
                    Surface(Modifier.fillMaxSize()) { DadbanApp() }
                }
            }
        }
    }
}

@Composable
private fun DadbanApp(vm: MainViewModel = viewModel()) {
    val state = vm.state
    val snackbar = remember { SnackbarHostState() }
    LaunchedEffect(state.message) {
        state.message?.let { snackbar.showSnackbar(it); vm.dismissMessage() }
    }
    Box(Modifier.fillMaxSize()) {
        when (state.screen) {
            AppScreen.AUTH -> AuthScreen(state, vm)
            AppScreen.PROFILE -> ProfileScreen(state, vm)
            AppScreen.HOME -> HomeScreen(state, vm)
            AppScreen.ANALYZE -> AnalyzeScreen(state, vm)
            AppScreen.RESULT -> ResultScreen(state, vm)
            AppScreen.LAW_BOOK -> LawBookScreen(state, vm)
            AppScreen.PREMIUM -> PremiumScreen(state, vm)
        }
        SnackbarHost(snackbar, Modifier.align(Alignment.BottomCenter))
        if (state.loading) {
            Surface(Modifier.fillMaxSize()) {
                Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
            }
        }
    }
}

