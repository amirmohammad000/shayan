            label = { Text("شماره همراه") },
            placeholder = { Text("0912xxxxxxx") },
            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Phone),
            singleLine = true
        )
        Spacer(Modifier.height(12.dp))
        Button(onClick = vm::loginWithPhone, modifier = Modifier.fillMaxWidth()) { Text("ورود") }
        Spacer(Modifier.height(14.dp))
        NoticeCard("نسخه آزمایشی: فعلاً ورود فقط با شماره همراه انجام می‌شود و کد پیامکی لازم نیست. پیش از انتشار عمومی باید ورود OTP دوباره فعال شود.")
        Spacer(Modifier.height(10.dp))
        NoticeCard("این سامانه اطلاعات حقوقی و پیش‌نویس ارائه می‌کند و نتیجه دادگاه را تضمین نمی‌کند. در تصمیم‌های حساس، بررسی وکیل ضروری است.")
    }
}

@Composable
private fun ProfileScreen(state: UiState, vm: MainViewModel) {
    var name by remember(state.profile.fullName) { mutableStateOf(state.profile.fullName) }
    var province by remember(state.profile.province) { mutableStateOf(state.profile.province) }
    var city by remember(state.profile.city) { mutableStateOf(state.profile.city) }
    Scaffold(topBar = { SimpleTopBar("تکمیل پروفایل") }) { padding ->
        Column(
            Modifier.fillMaxSize().padding(padding).padding(20.dp).verticalScroll(rememberScrollState()),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            Text("برای شخصی‌سازی حساب، مشخصات پایه را وارد کنید.")
            OutlinedTextField(name, { name = it }, Modifier.fillMaxWidth(), label = { Text("نام و نام خانوادگی") })
            OutlinedTextField(province, { province = it }, Modifier.fillMaxWidth(), label = { Text("استان - اختیاری") })
            OutlinedTextField(city, { city = it }, Modifier.fillMaxWidth(), label = { Text("شهر - اختیاری") })
            Text("شماره همراه: ${state.profile.phone}", color = MaterialTheme.colorScheme.onSurfaceVariant)
            Button(onClick = { vm.saveProfile(name, province, city) }, modifier = Modifier.fillMaxWidth()) { Text("ذخیره و ورود به برنامه") }
            NoticeCard("برای استفاده عمومی، اطلاعات حساس مثل کد ملی را فقط وقتی بگیرید که واقعاً برای یک خدمت مشخص لازم باشد.")
        }
    }
}

@Composable
private fun HomeScreen(state: UiState, vm: MainViewModel) {
    Scaffold(topBar = { SimpleTopBar("دادبان") }) { padding ->
        LazyColumn(
            Modifier.fillMaxSize().padding(padding),
            contentPadding = PaddingValues(16.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            item {
                Column {
                    Text("سلام ${state.profile.fullName.ifBlank { "" }}", style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold)
                    Text("مشکلت را بگو یا مدرکت را بفرست؛ جزئیات حقوقی را دادبان پشت صحنه بررسی می‌کند.", color = MaterialTheme.colorScheme.onSurfaceVariant)
                }
            }
            item { QuotaCard(state.entitlements) }
            item { MainAction("مشکلم را توضیح می‌دهم", "بدون نیاز به اصطلاحات حقوقی", "💬") { vm.startNewAnalysis("basic") } }
            item { MainAction("رأی یا ابلاغیه دارم", "فایل را بده تا ساده و مستند توضیح داده شود", "📄") { vm.startNewAnalysis("basic") } }
            item { MainAction("کتاب قانون", "جست‌وجوی ماده، قانون یا موضوع با متن رسمی", "📚") { vm.go(AppScreen.LAW_BOOK) } }
            item { MainAction("تحلیل عمیق", "دفاع‌ها، ریسک‌ها و استنادهای کامل‌تر", "🧠", locked = !state.entitlements.isPremium) { vm.startNewAnalysis("detailed") } }
            item { MainAction("نوشتن لایحه", "پیش‌نویس رسمی بر اساس پرونده و منابع معتبر", "✍️", locked = !state.entitlements.isPremium) { vm.startNewAnalysis("pleading") } }
            item {
                OutlinedButton(onClick = { vm.go(AppScreen.PREMIUM) }, modifier = Modifier.fillMaxWidth()) {
                    Text(if (state.entitlements.isPremium) "مدیریت حساب پریمیوم" else "مشاهده پریمیوم")
                }
            }
            item { TextButton(onClick = vm::logout, modifier = Modifier.fillMaxWidth()) { Text("خروج از حساب") } }
        }
    }
}

@Composable
private fun MainAction(title: String, subtitle: String, icon: String, locked: Boolean = false, onClick: () -> Unit) {
    Card(onClick = onClick, modifier = Modifier.fillMaxWidth()) {
        Row(Modifier.padding(18.dp), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
            Text(icon, style = MaterialTheme.typography.headlineSmall)
            Column(Modifier.weight(1f)) {
                Text(if (locked) "$title 🔒" else title, fontWeight = FontWeight.Bold)
                Text(subtitle, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
            }
            Text("‹")
        }
    }
}

@Composable
private fun QuotaCard(e: Entitlements) {
    Card(Modifier.fillMaxWidth()) {
        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
            if (!e.isPremium) {
